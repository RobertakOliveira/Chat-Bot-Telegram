{
	"Version": "2012-10-17",
	"Statement": [
	  {
		"Sid": "AllowS3AccessOnlyToSpecificBucket",
		"Effect": "Allow",
		"Action": [
		  "s3:GetObjectVersionTagging",
		  "s3:GetObject",
		  "s3:ListBucket"
		],
		"Resource": [
		  "arn:aws:s3:::${bucket_name}",
		  "arn:aws:s3:::${bucket_name}/*"
		]
	  },
	  {
		"Sid": "AllowLogs",
		"Effect": "Allow",
		"Action": [
		  "logs:*"
		],
		"Resource": "*"
	  },
	  {
		"Sid": "AllowBedrock",
		"Effect": "Allow",
		"Action": [
		  "bedrock:*"
		],
		"Resource": "*"
	  }
	]
  }
  